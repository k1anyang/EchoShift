# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Release archives assembled from dist/ (see README "发布一个版本").
*.zip

# --- test / scratch ---
.pytest_cache/
pytest-cache-files-*/
.tmp/
samples/
.mypy_cache/

# --- virtual environments ---
.venv/
venv/

# --- application ---
*.log
config.json

# Generated by tools/make_shortcut.ps1.  It hard-codes the absolute path of the
# Python interpreter and of launch_gui.pyw on the machine that produced it, so
# it is useless (and misleading) to anyone who clones the repository.
EchoShift.lnk
*.lnk

# --- vendored binaries are fetched, not committed ---
# vendor/ffmpeg/ is ~50 MB of ffmpeg + DLLs.  Populate it with
# tools/vendor_ffmpeg.ps1; releases ship the packed app instead.
# Uncomment the next two lines to keep the binaries out of the repo as well.
# vendor/ffmpeg/*.exe
# vendor/ffmpeg/*.dll
